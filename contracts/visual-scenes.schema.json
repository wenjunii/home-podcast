{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recovered-homes.local/contracts/visual-scenes.schema.json",
  "title": "Recovered Homes visual scene plan",
  "type": "object",
  "required": [
    "contract_version",
    "episode_id",
    "duration_ms",
    "master_track",
    "prompt_policy",
    "grounding_policy",
    "captions",
    "scenes"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1
    },
    "master_track": {
      "const": "voices_only"
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "caption_id",
          "start_ms",
          "end_ms",
          "speaker",
          "text"
        ]
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "start_ms",
          "end_ms",
          "duration_ms",
          "segment_ids",
          "source_story_ids",
          "grounding",
          "prompt"
        ],
        "properties": {
          "grounding": {
            "type": "object",
            "required": [
              "location_status",
              "locations",
              "identity_status",
              "identity_claims"
            ]
          },
          "prompt": {
            "type": "object",
            "required": [
              "status",
              "chunks",
              "seed"
            ],
            "properties": {
              "chunks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "role",
                    "text",
                    "weight"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
