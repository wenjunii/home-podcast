{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storytelling-script.schema.json",
  "title": "Recovered Homes Self-Narrated Story Adaptation",
  "type": "object",
  "required": [
    "contract_version",
    "narration_id",
    "source_story_id",
    "source_content_hash",
    "title",
    "source_language",
    "adaptation_language",
    "perspective_mode",
    "identity_constraints",
    "narrator_profile",
    "sections",
    "unresolved_gaps"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "narration_id": {"type": "string", "minLength": 1},
    "source_story_id": {"type": "string", "pattern": "^story-[a-f0-9]{24}$"},
    "source_content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "title": {"type": "string", "minLength": 1},
    "source_language": {"type": "string", "minLength": 2},
    "adaptation_language": {"type": "string", "minLength": 2},
    "perspective_mode": {
      "enum": [
        "first_person_preserved",
        "attributed_first_person"
      ]
    },
    "identity_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trait", "value", "evidence_excerpt"],
        "properties": {
          "trait": {
            "enum": [
              "narrator_gender_presentation",
              "narrator_accent",
              "narrator_language",
              "narrator_age_presentation",
              "narrator_role",
              "narrator_race",
              "narrator_ethnicity",
              "narrator_nationality",
              "narrator_religion",
              "narrator_disability",
              "narrator_class",
              "other"
            ]
          },
          "value": {"type": "string", "minLength": 1},
          "evidence_excerpt": {"type": "string", "minLength": 1}
        }
      }
    },
    "narrator_profile": {
      "type": "object",
      "required": [
        "personality_tags",
        "emotional_range_tags",
        "energy",
        "casting_notes"
      ],
      "properties": {
        "personality_tags": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "emotional_range_tags": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "energy": {
          "enum": ["very_low", "low", "medium", "high", "variable"]
        },
        "casting_notes": {"type": "string"}
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "text",
          "source_evidence",
          "delivery",
          "pause_after_ms"
        ],
        "properties": {
          "section_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "source_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["excerpt", "usage"],
              "properties": {
                "excerpt": {"type": "string", "minLength": 1},
                "usage": {
                  "enum": ["paraphrase_support", "direct_quote"]
                }
              }
            }
          },
          "delivery": {
            "type": "object",
            "required": ["emotion", "intensity", "pace", "nonverbal"],
            "properties": {
              "emotion": {"type": "string", "minLength": 1},
              "intensity": {"type": "number", "minimum": 0, "maximum": 1},
              "pace": {
                "enum": ["very_slow", "slow", "measured", "conversational", "quick"]
              },
              "nonverbal": {
                "type": "array",
                "items": {
                  "enum": [
                    "breath",
                    "soft_laugh",
                    "chuckle",
                    "sigh",
                    "hesitation",
                    "voice_catch",
                    "whispered_emphasis"
                  ]
                }
              },
              "direction": {"type": "string"}
            }
          },
          "pause_after_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    },
    "editorial_omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["excerpt", "classification", "reason"],
        "properties": {
          "excerpt": {"type": "string", "minLength": 1},
          "classification": {
            "enum": [
              "webpage_boilerplate",
              "navigation_or_contact_data",
              "duplicate_quoted_material",
              "duration_condensation",
              "non_narrative_taxonomy",
              "other_non_narrative_artifact"
            ]
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "condensation": {
      "type": "object",
      "required": ["policy", "full_adaptation_sha256", "editorial_summary"],
      "properties": {
        "policy": {"const": "one_story_under_five_minutes"},
        "full_adaptation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "editorial_summary": {"type": "string", "minLength": 1}
      }
    },
    "unresolved_gaps": {
      "type": "array",
      "items": {"type": "string"}
    },
    "adaptation_notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
