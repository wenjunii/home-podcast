{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-card.schema.json",
  "title": "Recovered Homes Story Card",
  "type": "object",
  "required": ["story_id", "content_hash", "analysis"],
  "properties": {
    "story_id": {"type": "string", "pattern": "^story-[a-f0-9]{24}$"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "analysis": {
      "type": "object",
      "required": [
        "eligible",
        "summary",
        "primary_theme",
        "secondary_themes",
        "theme_fit",
        "anchor_score",
        "emotional_tone",
        "digital_archaeology_angles",
        "memorable_passages",
        "sensitivity_notes",
        "translation_needed",
        "pronunciation_items",
        "usage_recommendation"
      ],
      "properties": {
        "eligible": {"type": "boolean"},
        "exclusion_reason": {"type": ["string", "null"]},
        "summary": {"type": "string"},
        "narrative_beats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "summary", "evidence_excerpt"],
            "properties": {
              "label": {"type": "string"},
              "summary": {"type": "string"},
              "evidence_excerpt": {"type": "string"}
            }
          }
        },
        "key_information": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim", "evidence_excerpt"],
            "properties": {
              "claim": {"type": "string"},
              "evidence_excerpt": {"type": "string"}
            }
          }
        },
        "people": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name_or_role", "supported_identity_details", "evidence_excerpt"],
            "properties": {
              "name_or_role": {"type": "string"},
              "supported_identity_details": {"type": "array", "items": {"type": "string"}},
              "evidence_excerpt": {"type": "string"}
            }
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["place", "role_in_story", "evidence_excerpt"],
            "properties": {
              "place": {"type": "string"},
              "role_in_story": {"type": "string"},
              "evidence_excerpt": {"type": "string"}
            }
          }
        },
        "time_markers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["time", "role_in_story", "evidence_excerpt"],
            "properties": {
              "time": {"type": "string"},
              "role_in_story": {"type": "string"},
              "evidence_excerpt": {"type": "string"}
            }
          }
        },
        "sensory_details": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["detail", "evidence_excerpt"],
            "properties": {
              "detail": {"type": "string"},
              "evidence_excerpt": {"type": "string"}
            }
          }
        },
        "unresolved_gaps": {"type": "array", "items": {"type": "string"}},
        "source_completeness": {
          "enum": ["likely_complete", "unknown", "start_missing", "end_missing", "both_missing", "gated_or_preview"]
        },
        "primary_theme": {"type": ["string", "null"]},
        "secondary_themes": {"type": "array", "items": {"type": "string"}},
        "theme_fit": {"type": "number", "minimum": 0, "maximum": 1},
        "anchor_score": {"type": "number", "minimum": 0, "maximum": 1},
        "emotional_tone": {"type": "string"},
        "digital_archaeology_angles": {"type": "array", "items": {"type": "string"}},
        "memorable_passages": {"type": "array", "items": {"type": "string"}},
        "sensitivity_notes": {"type": "array", "items": {"type": "string"}},
        "translation_needed": {"type": "boolean"},
        "pronunciation_items": {"type": "array", "items": {"type": "string"}},
        "usage_recommendation": {
          "enum": ["anchor", "featured", "supporting", "fragment", "contextual"]
        }
      }
    }
  }
}
