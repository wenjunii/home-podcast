{
  "project_name": "Recovered Homes",
  "primary_language": "en",
  "exports_dir": "../cc-home-extractor/data/exports",
  "catalog_path": "data/catalog.sqlite3",
  "themes_path": "config/themes.json",
  "show_bible_path": "config/show_bible.json",
  "voice_roster_path": "config/voice_roster.json",
  "episodes_dir": "episodes",
  "work_dir": "work",
  "audio_dir": "audio",
  "target_stories_per_installment": 30,
  "target_minutes_min": 20,
  "target_minutes_max": 35,
  "analysis_provider": {
    "type": "capriole",
    "endpoint": "https://api.caprioletech.com/v1/chat",
    "model": "anthropic/claude-fable-5",
    "api_key_env": "CAPRIOLE_API_KEY",
    "timeout_seconds": 180
  },
  "script_provider": {
    "type": "capriole",
    "endpoint": "https://api.caprioletech.com/v1/messages",
    "model": "anthropic/claude-opus-4-6",
    "api_key_env": "CAPRIOLE_API_KEY",
    "timeout_seconds": 600,
    "max_attempts": 1,
    "protocol": "anthropic_messages_stream",
    "max_tokens": 4096
  },
  "speech_provider": {
    "type": "elevenlabs_tts",
    "endpoint": "https://api.elevenlabs.io/v1/text-to-speech",
    "model": "eleven_v3",
    "api_key_env": "ELEVENLABS_API_KEY",
    "timeout_seconds": 180,
    "max_attempts": 4,
    "output_format": "mp3_44100_128",
    "language_code": "en",
    "voice_settings": {
      "stability": 0.5,
      "similarity_boost": 0.75,
      "style": 0,
      "use_speaker_boost": true
    },
    "credits_per_character": 1,
    "usd_per_thousand_characters": 0.1
  },
  "dialogue_provider": {
    "type": "elevenlabs_dialogue",
    "endpoint": "https://api.elevenlabs.io/v1/text-to-dialogue",
    "model": "eleven_v3",
    "api_key_env": "ELEVENLABS_API_KEY",
    "timeout_seconds": 180,
    "max_attempts": 4,
    "output_format": "mp3_44100_128",
    "language_code": "en",
    "credits_per_character": 1,
    "usd_per_thousand_characters": 0.1
  },
  "sound_effects_provider": {
    "type": "elevenlabs_sound_effects",
    "endpoint": "https://api.elevenlabs.io/v1/sound-generation",
    "model": "eleven_text_to_sound_v2",
    "api_key_env": "ELEVENLABS_API_KEY",
    "timeout_seconds": 180,
    "max_attempts": 4,
    "prompt_influence": 0.3,
    "credits_per_second": 11
  }
}
